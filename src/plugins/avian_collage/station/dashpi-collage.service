[Unit]
Description=Render the AvianVisitors collage PNGs for DashPi
Documentation=https://github.com/SHagler2/DashPi/tree/main/src/plugins/avian_collage
Wants=network-online.target
After=network-online.target caddy.service

[Service]
Type=oneshot
User=admin
ExecStart=/home/admin/dashpi-collage/render.sh
Nice=10
TimeoutStartSec=300
NoNewPrivileges=true
